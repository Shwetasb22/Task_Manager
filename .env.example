# Copy to .env.local and fill in (Supabase → Project Settings → API).
# Leave both empty to run in browser-only DEMO mode.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# ───────────── Server-only settings (never prefixed NEXT_PUBLIC_, never sent to browsers) ─────────────
# Used by the scripts in scripts/ (morning alerts, backups). Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Address people use to open the app; used in email links.
APP_URL=http://10.91.50.252:3000

# Morning alert email (scripts/daily-digest.mjs). Ask Brembo IT for the internal SMTP relay.
DIGEST_SMTP_HOST=
DIGEST_SMTP_PORT=25
DIGEST_SMTP_SECURE=false
DIGEST_SMTP_USER=
DIGEST_SMTP_PASS=
DIGEST_FROM=OPL Tracker <opl-tracker@bremboindia.com>
# Days with no email, 0 = Sunday (comma separated, e.g. 0,6 for weekends).
DIGEST_SKIP_DAYS=0
# Optional: a Teams channel webhook (Teams → channel → Workflows → "Post to a channel when a webhook request is received").
DIGEST_TEAMS_WEBHOOK=

# Archive (scripts/archive.mjs): issues closed more than this many days ago are not loaded on open.
ARCHIVE_DAYS=365

# Nightly backup (scripts/backup.mjs): days of backups to keep; BACKUP_FILES=false skips proof files.
BACKUP_KEEP_DAYS=30
BACKUP_FILES=true

# Alerts (docs/OPERATIONS.md section 5): a Teams channel webhook for "app down", "backups stopped" and
# errors in people's browsers. Leave empty for no alerts (errors are still in pm2 logs).
ALERT_TEAMS_WEBHOOK=

# Set by scripts/deploy.* — only needed when running without it: where backups and "sent today"
# markers are kept (default: the app folder).
# OPL_STATE_DIR=
